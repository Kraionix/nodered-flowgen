{
  "name": "@kraionix/nodered-flowgen",
  "version": "0.1.0",
  "description": "Declarative, type-checked Node-RED flow generation: palette-derived TypeScript types, a canonical emitter, and rev-checked plan/apply.",
  "keywords": [
    "node-red",
    "flow",
    "codegen",
    "declarative",
    "infrastructure-as-code",
    "typescript"
  ],
  "license": "MIT",
  "author": "Kraionix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kraionix/nodered-flowgen.git"
  },
  "homepage": "https://github.com/Kraionix/nodered-flowgen#readme",
  "bugs": {
    "url": "https://github.com/Kraionix/nodered-flowgen/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./toolkit": {
      "types": "./dist/toolkit/index.d.ts",
      "default": "./dist/toolkit/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "flowgen": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/*.test.ts\" \"test/integration/*.spec.ts\"",
    "pretest": "npm run build",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:integration": "node --test \"test/integration/*.spec.ts\"",
    "pretest:integration": "npm run build",
    "prepack": "npm run build",
    "types:regen": "node test/types/regen.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "node-red": "^5.0.8",
    "node-red-dashboard": "^3.6.6",
    "nrlint": "^1.2.0",
    "typescript": "^7.0.2"
  }
}
