    {
        "id": "x_factor_1",
        "type": "function",
        "z": "scale_sf_1",
        "name": "x factor",
        "func": "const factor = env.get(\"factor\");\nconst tag = env.get(\"tag\");\nmsg.factor = factor; msg.tag = tag;\nmsg.payload = msg.payload * factor;\nreturn msg;",
        "outputs": 1,
        "timeout": "[Function]",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 160,
        "y": 80,
        "wires": [
            []
        ]
    },
    {
        "id": "get_recon_scale_1",
        "type": "http in",
        "name": "GET /recon/scale",
        "url": "/recon/scale",
        "method": "get",
        "upload": false,
        "skipBodyParsing": false,
        "z": "tab_1",
        "wires": [
            [
                "read_x_1"
            ]
        ],
        "x": 120,
        "y": 80
    },
    {
        "id": "read_x_1",
        "type": "function",
        "name": "read ?x=",
        "func": "msg.payload = Number(msg.req.query.x ?? 1);\nreturn msg;",
