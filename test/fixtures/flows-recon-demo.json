[
    {
        "id": "scale_sf_1",
        "type": "subflow",
        "name": "scale x factor",
        "info": "Multiplies msg.payload by the `factor` subflow parameter.\nOverridable per instance.",
        "category": "function",
        "in": [
            {
                "x": 100,
                "y": 100,
                "wires": [
                    {
                        "id": "x_factor_1"
                    }
                ]
            }
        ],
        "out": [
            {
                "x": 500,
                "y": 100,
                "wires": [
                    {
                        "id": "x_factor_1",
                        "port": 0
                    }
                ]
            }
        ],
        "env": [
            {
                "name": "factor",
                "type": "num",
                "value": "2"
            },
            {
                "name": "tag",
                "type": "str",
                "value": "default"
            },
            {
                "name": "verbose",
                "type": "bool",
                "value": "true"
            },
            {
                "name": "secret",
                "type": "cred",
                "value": ""
            }
        ],
        "meta": {},
