{
  "compilerOptions": {
    "target": "es2024",
    "lib": [
      "es2024"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@kraionix/nodered-flowgen": ["../../src/index.ts"],
      "@kraionix/nodered-flowgen/toolkit": ["../../src/toolkit/index.ts"]
    }
  },
  "include": [
    "positive.ts",
    "tiers/**/*.ts",
    "palettes/**/*.d.ts"
  ]
}
